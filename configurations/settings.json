{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-2",
    "AWS_PROFILE": "default",
    "CPS_LSP_BINARY": "<USER_HOME>/.vscode/extensions/ms-copilotstudio.vscode-copilotstudio-1.4.37-win32-x64/lspOut/LanguageServerHost.exe"
  },
  "model": "us.anthropic.claude-sonnet-4-6[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/secret-scanner.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/dangerous-command-blocker.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/office-open-as-user.py\"",
            "statusMessage": "Checking Office file open..."
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/databricks-all-purpose-cluster.py\"",
            "statusMessage": "Enforcing all-purpose cluster..."
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/de-skill-activator.py\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/change-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/repo-sync.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-session-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-memory-sync.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/change-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/repo-sync.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-session-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-memory-sync.py\""
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/change-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/repo-sync.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-session-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-memory-sync.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/change-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/obsidian-session-logger.py\""
          },
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/aws-cost-tracker.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ADMIN_HOME>/.claude/hooks/qa-gate-enforcer.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "copilot-studio@skills-for-copilot-studio": true
  },
  "extraKnownMarketplaces": {
    "skills-for-copilot-studio": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-copilot-studio"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true
}